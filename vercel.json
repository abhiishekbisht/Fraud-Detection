{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/cleaned-datasets",
      "destination": "/api/index.py"
    },
    {
      "source": "/upload(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/eda(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/train(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/predict(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/reset",
      "destination": "/api/index.py"
    },
    {
      "source": "/downloads(.*)",
      "destination": "/api/index.py"
    }
  ]
}
