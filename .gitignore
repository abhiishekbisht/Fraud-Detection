# ==========================================
# FraudLens - Git Ignore & Security Policy
# Ensures ONLY safe source code, configs, tests & docs are committed to Git
# ==========================================

# Byte-compiled / Python cached files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Package Managers
.venv/
venv/
env/
ENV/
node_modules/
frontend/node_modules/

# Local Databases & Raw/Cleaned Datasets (Privacy & Security)
*.db
*.sqlite
*.sqlite3
fraudlens.db
data/*
!data/.gitkeep
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/models/.gitkeep

# Machine Learning Model Weights & Scaler Artifacts
*.joblib
*.pkl
*.h5
*.onnx
models/

# Build Outputs & Bundles
dist/
dist-ssr/
frontend/dist/
build/
*.egg-info/
.eggs/

# Environment Secrets & Credentials
.env
.env.local
.env.production
.env.staging
!.env.example
*.pem
*.key

# Test & Coverage Outputs
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# OS Metadata
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
